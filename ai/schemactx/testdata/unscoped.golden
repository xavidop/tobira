dialect: fake
kind: other
namespace: main
collections:
  - name: main.tobira_people
    type: table
    rows: 57
    fields:
      - id int pk auto
      - name string
      - email string
      - age int
      - score decimal
      - active bool
      - created_at time
      - tags json
  - name: main.orders
    type: table
    rows: 1
    comment: customer orders; token xxxxx
    fields:
      - id int pk auto
      - person_id int
      - status text default 'open'  # order state open or paid
    indexes:
      - orders_status(status)
    foreign_keys:
      - person_id -> main.tobira_people(id)
  - name: main.items
    type: table
    rows: 0
    fields:
      - id int pk auto
      - order_id int
      - sku string
    foreign_keys:
      - order_id -> main.orders(id)
  - name: main.audit
    type: table
    rows: 0
    fields:
      - at time
  - name: main.zeta
    type: table
    rows: 0
    fields:
      - z int
other_collections: [extra_0, extra_1, extra_2, extra_3]
