# tobira - multi-module monorepo Makefile.
# Each module is built/tested independently with the workspace disabled, matching CI.

# All Go modules in the repo, discovered dynamically: every directory with a
# go.mod, excluding the docs site, node_modules, and testdata. New driver
# modules are picked up automatically, so this never needs updating.
MODULES := $(shell find . -name go.mod \
	-not -path './site/*' \
	-not -path './node_modules/*' \
	-not -path '*/testdata/*' \
	-exec dirname {} \; | sort)

GO ?= go
export GOWORK = off

.PHONY: all build test race vet lint lint-integration fmt tidy work-sync check-deps check-claims proto proto-check test-aifake vet-aifake lint-aifake site-dev site-build site-linkcheck demo clean help

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

all: fmt proto-check vet vet-aifake check-deps check-claims test test-aifake lint lint-integration lint-aifake ## fmt, proto-check, vet, check-deps, check-claims, test and lint every module, plus the aifake suites

build: ## go build every module
	@for m in $(MODULES); do echo "==> build $$m"; (cd $$m && $(GO) build ./...) || exit 1; done

test: ## go test every module
	@for m in $(MODULES); do echo "==> test $$m"; (cd $$m && $(GO) test ./...) || exit 1; done

race: ## go test -race every module
	@for m in $(MODULES); do echo "==> test -race $$m"; (cd $$m && $(GO) test -race ./...) || exit 1; done

vet: ## go vet every module
	@for m in $(MODULES); do echo "==> vet $$m"; (cd $$m && $(GO) vet ./...) || exit 1; done

lint: ## golangci-lint every module (requires golangci-lint)
	@for m in $(MODULES); do echo "==> lint $$m"; (cd $$m && golangci-lint run --timeout=5m) || exit 1; done

lint-integration: ## golangci-lint -tags integration for every module (the container-backed suites)
	@for m in $(MODULES); do echo "==> lint -tags integration $$m"; (cd $$m && golangci-lint run --timeout=5m --build-tags integration) || exit 1; done

fmt: ## Check the tree is gofmt-clean (fails and lists files instead of rewriting them)
	@out=$$(gofmt -l .); \
	if [ -n "$$out" ]; then \
		echo "not gofmt-clean:"; echo "$$out"; exit 1; \
	fi

tidy: ## go mod tidy every module
	@for m in $(MODULES); do echo "==> tidy $$m"; (cd $$m && $(GO) mod tidy) || exit 1; done

work-sync: ## Regenerate the go.work workspace (then re-tidy modules)
	@GOWORK= $(GO) work sync
	@$(MAKE) tidy

# The end-to-end AI tests (a fake model provider, no network) build only with
# -tags aifake, so a default build never contains the fake provider. These
# targets build, vet, test and lint them: module dir, then its packages.
AIFAKE := .:./internal/config/... ai:./... cmd/tobira:./...

test-aifake: ## go test -tags aifake for the fake-provider suites (root config, ai, cmd/tobira)
	@for p in $(AIFAKE); do d=$${p%%:*}; pkgs=$${p#*:}; echo "==> test -tags aifake $$d $$pkgs"; \
		(cd $$d && $(GO) test -timeout 30m -tags aifake $$pkgs) || exit 1; done

vet-aifake: ## go vet -tags aifake for the fake-provider suites
	@for p in $(AIFAKE); do d=$${p%%:*}; pkgs=$${p#*:}; echo "==> vet -tags aifake $$d $$pkgs"; \
		(cd $$d && $(GO) vet -tags aifake $$pkgs) || exit 1; done

lint-aifake: ## golangci-lint -tags aifake for the fake-provider suites
	@for p in $(AIFAKE); do d=$${p%%:*}; pkgs=$${p#*:}; echo "==> lint -tags aifake $$d $$pkgs"; \
		(cd $$d && golangci-lint run --timeout=5m --build-tags aifake $$pkgs) || exit 1; done

# The plugin protocol (plugin/proto) is generated with buf and committed. buf,
# protoc-gen-go and protoc-gen-go-grpc are all pinned and run with `go run`
# (see buf.gen.yaml), so nothing needs installing and nothing comes from the
# Buf Schema Registry. GOPROXY puts the local module cache first, so once the
# tools have been downloaded both targets run offline. proto-check compares
# only generated *.pb.go files, so hand-written files under plugin/proto are
# left alone.
BUF_VERSION := v1.73.0
BUF = GOPROXY="file://$$($(GO) env GOMODCACHE)/cache/download,$$($(GO) env GOPROXY)" \
	$(GO) run github.com/bufbuild/buf/cmd/buf@$(BUF_VERSION)

proto: ## Regenerate the plugin protocol's Go code from plugin/proto
	@$(BUF) generate

proto-check: ## Fail if the committed plugin protocol code is not what `make proto` generates
	@tmp=$$(mktemp -d); trap 'rm -rf "$$tmp"' EXIT; \
	$(BUF) generate -o "$$tmp" || exit 1; \
	stale=0; \
	for f in $$(cd "$$tmp" && find plugin/proto -name '*.pb.go'); do \
		diff -u "$$f" "$$tmp/$$f" || stale=1; \
	done; \
	for f in $$(find plugin/proto -name '*.pb.go'); do \
		[ -f "$$tmp/$$f" ] || { echo "$$f is not generated by any proto"; stale=1; }; \
	done; \
	if [ "$$stale" -ne 0 ]; then \
		echo "plugin/proto is stale: run make proto and commit the result"; exit 1; \
	fi; \
	echo "proto-check: plugin/proto is up to date"

check-deps: ## Fail if the root module depends on any database SDK (and prove the denylist covers every driver SDK)
	@bash .github/scripts/check_root_deps.sh .
	@bash .github/scripts/check_root_deps_selftest.sh

check-claims: ## Fail if the README or docs claim unshipped capabilities, or disagree with the CLI, drivers or each other
	@bash .github/scripts/check_readme_claims.sh
	@bash .github/scripts/check_docs_claims.sh

site-dev: ## Run the docs site dev server (Node 22 via nvm)
	@bash -lc 'source "$$HOME/.nvm/nvm.sh" && nvm use 22 && cd site && npm install && npm run dev'

site-build: ## Build the docs site (Node 22 via nvm)
	@bash -lc 'source "$$HOME/.nvm/nvm.sh" && nvm use 22 && cd site && npm install && npm run build'

site-linkcheck: ## Build the docs site and check for broken internal links (Node 22 via nvm)
	@bash -lc 'source "$$HOME/.nvm/nvm.sh" && nvm use 22 && cd site && npm install && npm run build && npm run linkcheck'

demo: ## Record site/public/demo.gif with vhs (needs vhs, ttyd and ffmpeg)
	@command -v vhs >/dev/null || { echo "vhs is not installed: brew install vhs (or see https://github.com/charmbracelet/vhs#installation)"; exit 1; }
	@mkdir -p bin site/public
	@(cd cmd/tobira && $(GO) build -o ../../bin/tobira .)
	@bash scripts/demo-seed.sh ./bin/tobira /tmp/tobira-demo.db /tmp/tobira-demo/config.yaml
	@vhs demo.tape

clean: ## Remove build artifacts
	@rm -rf dist completions site/dist site/.astro
